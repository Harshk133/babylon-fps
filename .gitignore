# Dependencies
node_modules/

# Build
.next/
dist/
build/

# Environment
.env
.env.*
!.env.example
!.env.android

# Assets: commit only what the game loads (~10 MB, optimized). The heavy
# originals stay local; regenerate the .opt files with `npm run optimize-assets`.
public/models/*.glb
!public/models/*.opt.glb
public/models/rusty_roof_wooden_house_1_3d_model_free.opt.glb
public/models/monster.md2
public/trees/*.glb
!public/trees/*.opt.glb
!public/trees/*.lod1.glb
public/models/soldier/soldier.glb
public/texture/grass2.jpg
public/texture/ratamahatta.png

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Android build output
*.apk

# Indian models (Sketchfab downloads): only the optimized copies are committed
public/models/india/*.glb
!public/models/india/*.opt.glb
public/models/india/*.zip
public/models/india/*/

# Mixamo downloads (Adobe's terms forbid redistributing the raw files): only the
# game's optimized GLBs are committed; tools/mixamo/convert.html makes raw/ from them
public/models/mixamo/characters/
public/models/mixamo/anims/
public/models/mixamo/raw/

# Source files for the models made for the game (the optimized copies go to public/models/india/)
public/models/indian things/

# Gear originals (Sketchfab downloads); only the optimized copies are committed
public/models/gear/*.glb
!public/models/gear/*.opt.glb
